# ============================================
# Python Bytecode & Cache (ملفات الكاش المؤقتة)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================
# Virtual Environments (البيئة الافتراضية)
# ============================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================
# Environment Variables & Secrets (المتغيرات السرية)
# ============================================
.env
.env.*
!.env.example

# ============================================
# IDEs & Editors (إعدادات محررات الأكواد)
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ============================================
# Jupyter Notebooks Checkpoints (ملفات النوت بوك المؤقتة)
# ============================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================
# OS Generated Files (ملفات النظام التلقائية)
# ============================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ============================================
# Large Datasets / Trained Models (اختياري: ملفات النماذج والبيانات الضخمة)
# ============================================
# إذا كانت ملفات النماذج أكبر من 100MB قم بإلغاء التعليق عن السطر التالي:
# models/*.joblib
# models/*.pkl
